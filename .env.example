# ── Credenciales de Bitso ─────────────────────────────────────────────────────
# Permisos requeridos: "View balances" + "Place orders". Sin retiros.
BITSO_API_KEY=
BITSO_API_SECRET=

# ── Bot de Telegram ───────────────────────────────────────────────────────────
# Obtén el token con @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Tu chat ID (usa @userinfobot en Telegram para obtenerlo)
TELEGRAM_CHAT_ID=

# ── TradingView CDP ───────────────────────────────────────────────────────────
# Puerto donde TradingView Desktop corre con --remote-debugging-port
TRADINGVIEW_CDP_PORT=9222

# ── Modo de operación ─────────────────────────────────────────────────────────
# dry_run      → simula órdenes, no toca Bitso, prefijo [SIMULADO]
# operational  → órdenes reales con capital real, prefijo [REAL]
BOT_MODE=dry_run

# ── Capital y riesgo ─────────────────────────────────────────────────────────
# Capital de referencia en MXN. Base para todos los cálculos de riesgo.
# No tiene que coincidir con el saldo en Bitso; es el capital que decides arriesgar.
CAPITAL_REF_MXN=5000

# Riesgo por operación como fracción del capital (0.01 = 1%).
# Posición = CAPITAL_REF_MXN * RISK_PCT_PER_TRADE / STOP_LOSS_PCT
# Con los defaults: 5000 * 0.01 / 0.02 = 2500 MXN, limitado a MAX_TRADE_MXN.
RISK_PCT_PER_TRADE=0.01

# Tope duro sobre el tamaño de posición (MXN).
MAX_TRADE_MXN=500

# ── Límites de pérdida ────────────────────────────────────────────────────────
# Pérdida diaria máxima como fracción del capital. 0.03 = 3% = -150 MXN sobre 5000.
# Al superarla, el bot bloquea nuevas entradas hasta el día siguiente.
DAILY_LOSS_PCT=0.03

# Kill switch: drawdown global desde el equity máximo. 0.10 = 10%.
# Al superarlo, cierra la posición y bloquea el bot hasta revisión manual.
DRAWDOWN_KILL_PCT=0.10

# Stop-loss por operación (caída % desde precio de entrada).
STOP_LOSS_PCT=0.02

# ── Filtros de entrada ────────────────────────────────────────────────────────
# Spread máximo permitido (ask-bid)/ask. 0.005 = 0.5%.
# Protege contra entradas en mercados con baja liquidez o picos de volatilidad.
MAX_SPREAD_PCT=0.005

# RSI umbral de compra (sobreventa) y venta (sobrecompra).
RSI_BUY=30
RSI_SELL=70

# Mínimo de horas entre operaciones.
MIN_HOURS_BETWEEN_TRADES=1

# Máximo de operaciones por día.
MAX_TRADES_DAY=3

# ── Zona horaria ─────────────────────────────────────────────────────────────
TZ=America/Mexico_City
